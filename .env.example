NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Desarrollo local: ruta a un JSON de service account ignorado por Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternativa para Vercel: JSON completo del service account, en una sola variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa mas robusta para Vercel: service account codificado en base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opcional: correos Google permitidos, separados por coma. Vacio permite cualquier cuenta autenticada.
ALLOWED_GOOGLE_EMAILS=
